layout_uv() {
  if [[ ! -f pyproject.toml ]]; then
    log_error 'No pyproject.toml found. Use `uv init` to create one first.'
    exit 2
  fi

  # create/sync the venv if it doesn't exist or is out of date
  uv sync

  export VIRTUAL_ENV="$PWD/.venv"
  export UV_ACTIVE=1
  PATH_add "$VIRTUAL_ENV/bin"
}
