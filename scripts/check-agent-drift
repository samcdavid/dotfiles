#!/usr/bin/env python3
"""Check Claude/Codex skill, agent, rule, and RCM drift."""

from __future__ import annotations

import argparse
from pathlib import Path
import re
import subprocess
import sys
import tomllib


ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()
ENTRYPOINT_LIMIT = 700
REFERENCE_LIMIT = 6000
CRITICAL_AGENT_NAMES = {
    "adversarial-debate",
    "arch-reviewer",
    "perf-reviewer",
    "security-reviewer",
}

# Must mirror EFFORT_TO_CODEX in scripts/sync-codex-agents.
EFFORT_TO_CODEX = {
    "low": "low",
    "medium": "medium",
    "high": "high",
    "xhigh": "xhigh",
    "max": "xhigh",
}

# Backtick-quoted markdown paths, e.g. `references/protocol-index.md`.
LINK_PATTERN = re.compile(r"`([~\w][^`\s]*\.md)`")
# Placeholder-ish citations that are illustrative, not real files.
LINK_PLACEHOLDER = re.compile(r"[<>{}*|]|/step-N\.md$|<name>|\.\.\.")
FRONTMATTER_PATTERN = re.compile(r"\A---\s*\n(.*?)\n---\s*(?:\n|\Z)", re.DOTALL)
RUNNER_NAME_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]*\Z")


def rel(path: Path) -> str:
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        return str(path)


def is_symlink_to(path: Path, expected: str) -> bool:
    return path.is_symlink() and path.readlink().as_posix() == expected


def word_count(path: Path) -> int:
    return len(re.findall(r"\S+", path.read_text(errors="replace")))


def run(cmd: list[str]) -> tuple[int, str]:
    proc = subprocess.run(
        cmd,
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    return proc.returncode, proc.stdout.strip()


def frontmatter(path: Path) -> tuple[dict[str, str], str | None]:
    """Parse the simple scalar frontmatter used by canonical instructions."""
    text = path.read_text(errors="replace")
    match = FRONTMATTER_PATTERN.match(text)
    if not match:
        return {}, "missing or malformed frontmatter"

    fields: dict[str, str] = {}
    for raw_line in match.group(1).splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if ":" not in line:
            return {}, f"frontmatter line is not key/value: {line!r}"
        key, value = line.split(":", 1)
        key = key.strip()
        if not key:
            return {}, "frontmatter key is empty"
        fields[key] = value.strip().strip("\"'")
    return fields, None


def valid_runner_name(value: str) -> bool:
    return bool(RUNNER_NAME_PATTERN.fullmatch(value))


def check_runner_pairs(
    errors: list[str], skills_root: Path | None = None, agents_root: Path | None = None
) -> None:
    """Validate only explicitly declared skill/runner pairs.

    Unpaired skills and specialist agents deliberately remain outside this
    contract. Runner sources stay flat because ``sync-codex-agents`` only
    generates TOML from ``claude/agents/*.md``.
    """
    skills_root = skills_root or ROOT / "claude" / "skills"
    agents_root = agents_root or ROOT / "claude" / "agents"
    if not skills_root.is_dir() or not agents_root.is_dir():
        errors.append(
            "runner-pair root must contain skills/ and agents/ directories"
        )
        return

    skills: dict[str, tuple[Path, dict[str, str]]] = {}
    declared_skill_runners: dict[str, tuple[Path, str]] = {}
    for path in sorted(skills_root.glob("*/SKILL.md")):
        fields, parse_error = frontmatter(path)
        if "runner" not in fields:
            continue
        if parse_error:
            errors.append(f"{rel(path)} has malformed runner metadata: {parse_error}")
            continue

        skill_name = fields.get("name", path.parent.name).strip()
        runner = fields["runner"].strip()
        if not valid_runner_name(runner):
            errors.append(
                f"{rel(path)} has malformed runner metadata: "
                "runner must be a non-empty agent name"
            )
            continue
        if not valid_runner_name(skill_name):
            errors.append(
                f"{rel(path)} has malformed runner metadata: "
                "skill name must be a non-empty skill name"
            )
            continue
        if skill_name in skills:
            errors.append(
                f"{rel(path)} duplicates paired skill name '{skill_name}' "
                f"from {rel(skills[skill_name][0])}"
            )
            continue
        skills[skill_name] = (path, fields)
        declared_skill_runners[skill_name] = (path, runner)

    agents: dict[str, tuple[Path, dict[str, str]]] = {}
    declared_agent_runners: dict[str, tuple[Path, dict[str, str]]] = {}
    for path in sorted(agents_root.glob("*.md")):
        fields, parse_error = frontmatter(path)
        if parse_error or not fields.get("name", "").strip():
            continue
        agent_name = fields["name"].strip()
        if not valid_runner_name(agent_name):
            if "runner-for" in fields:
                errors.append(
                    f"{rel(path)} has malformed runner metadata: "
                    "name must be a non-empty agent name"
                )
            continue
        if agent_name not in agents:
            agents[agent_name] = (path, fields)
        if "runner-for" not in fields:
            continue
        runner_for = fields["runner-for"].strip()
        if not valid_runner_name(runner_for):
            errors.append(
                f"{rel(path)} has malformed runner metadata: "
                "runner-for must be a non-empty skill name"
            )
            continue
        if agent_name in declared_agent_runners:
            errors.append(
                f"{rel(path)} duplicates paired runner name '{agent_name}' "
                f"from {rel(declared_agent_runners[agent_name][0])}"
            )
            continue
        declared_agent_runners[agent_name] = (path, fields)
        for field in ("model", "effort", "codex-model"):
            if not fields.get(field, "").strip():
                errors.append(f"{rel(path)} missing required runner field: {field}")

    for skill_name, (skill_path, runner_name) in declared_skill_runners.items():
        runner = agents.get(runner_name)
        if runner is None:
            errors.append(
                f"{rel(skill_path)} declares runner '{runner_name}', but no flat "
                "agent source has that name"
            )
            continue

        runner_path, runner_fields = runner
        if "runner-for" not in runner_fields:
            errors.append(
                f"{rel(runner_path)} is runner '{runner_name}' for "
                f"{rel(skill_path)} but is missing runner-for metadata"
            )
            continue
        runner_for = runner_fields["runner-for"].strip()
        if runner_for != skill_name:
            errors.append(
                f"{rel(runner_path)} runner-for '{runner_for}' does not "
                f"reciprocate skill '{skill_name}' declared by {rel(skill_path)}"
            )

    for agent_name, (agent_path, agent_fields) in declared_agent_runners.items():
        runner_for = agent_fields["runner-for"].strip()
        skill = skills.get(runner_for)
        if skill is None:
            errors.append(
                f"{rel(agent_path)} declares runner-for '{runner_for}', but no "
                "paired skill wrapper has that name"
            )
            continue
        skill_path, skill_fields = skill
        if skill_fields["runner"].strip() != agent_name:
            errors.append(
                f"{rel(skill_path)} runner '{skill_fields['runner'].strip()}' "
                f"does not reciprocate runner '{agent_name}' for skill '{runner_for}'"
            )


def check_repo_links(errors: list[str]) -> None:
    if not is_symlink_to(ROOT / "AGENTS.md", "CLAUDE.md"):
        errors.append("AGENTS.md must be a symlink to CLAUDE.md")

    rcrc = (ROOT / "rcrc").read_text(errors="replace")
    if "AGENTS.md" not in rcrc:
        errors.append("rcrc must exclude AGENTS.md")

    if not is_symlink_to(ROOT / "agents" / "rules", "../claude/rules"):
        errors.append("agents/rules must symlink to ../claude/rules")

    claude_skills = {
        path.name
        for path in (ROOT / "claude" / "skills").iterdir()
        if path.is_dir()
    }
    exposed_skills = {
        path.name
        for path in (ROOT / "agents" / "skills").iterdir()
        if path.is_symlink()
    }

    for name in sorted(claude_skills - exposed_skills):
        errors.append(f"missing Codex skill symlink: agents/skills/{name}")
    for name in sorted(exposed_skills - claude_skills):
        errors.append(f"stale Codex skill symlink: agents/skills/{name}")

    for name in sorted(claude_skills & exposed_skills):
        expected = f"../../claude/skills/{name}"
        if not is_symlink_to(ROOT / "agents" / "skills" / name, expected):
            errors.append(f"agents/skills/{name} should point to {expected}")


def check_codex_agents(errors: list[str]) -> None:
    code, output = run(["scripts/sync-codex-agents", "--check"])
    if code != 0:
        errors.append("codex agents are out of sync:\n" + output)

    for path in sorted((ROOT / "codex" / "agents").glob("*.toml")):
        try:
            data = tomllib.loads(path.read_text())
        except Exception as exc:
            errors.append(f"{rel(path)} is invalid TOML: {exc}")
            continue

        for key in ("name", "description", "developer_instructions"):
            if not data.get(key):
                errors.append(f"{rel(path)} missing {key}")

        source_name = data.get("name")
        source = ROOT / "claude" / "agents" / f"{source_name}.md"
        source_text = source.read_text(errors="replace") if source.exists() else ""
        source_is_opus = "model: opus" in source_text
        effort_match = re.search(r"^effort:\s*(\S+)\s*$", source_text, re.M)

        if effort_match:
            # An explicit `effort` is the source of truth; xhigh is only the
            # fallback for agents that express intent via `model: opus`.
            expected = EFFORT_TO_CODEX.get(effort_match.group(1).strip().lower())
            if expected is None:
                errors.append(f"{rel(source)} has unknown effort: {effort_match.group(1)}")
            elif data.get("model_reasoning_effort") != expected:
                errors.append(
                    f"{rel(path)} should set model_reasoning_effort = \"{expected}\" "
                    f"to match source effort"
                )
        elif source_is_opus or source_name in CRITICAL_AGENT_NAMES:
            if data.get("model_reasoning_effort") != "xhigh":
                errors.append(f"{rel(path)} should set model_reasoning_effort = \"xhigh\"")

        # A per-agent `codex-model` is the only way a tiered agent pair gets two
        # different Codex models, so a silent mismatch here would collapse both
        # tiers onto one model without any visible symptom.
        codex_model = re.search(r"^codex-model:\s*(\S+)\s*$", source_text, re.M)
        if codex_model:
            expected_model = codex_model.group(1).strip().strip("\"'")
            if data.get("model") != expected_model:
                errors.append(
                    f"{rel(path)} should set model = \"{expected_model}\" "
                    f"to match source codex-model"
                )


def check_budget(errors: list[str]) -> None:
    files = list((ROOT / "claude" / "skills").glob("**/SKILL.md"))
    files += list((ROOT / "claude" / "agents").glob("*.md"))
    for path in sorted(files):
        words = word_count(path)
        if words > ENTRYPOINT_LIMIT:
            errors.append(f"{rel(path)} has {words} words; limit is {ENTRYPOINT_LIMIT}")

    # References are loaded on demand, so they get a far larger budget than an
    # entrypoint — but a reference that outgrows this cap should be split by
    # topic rather than left as a single unnavigable wall.
    for path in sorted((ROOT / "claude" / "skills").glob("*/references/**/*.md")):
        words = word_count(path)
        if words > REFERENCE_LIMIT:
            errors.append(
                f"{rel(path)} has {words} words; reference limit is {REFERENCE_LIMIT}"
                " — split it by topic"
            )

    # Runner procedures live below their flat agent entrypoint (for example,
    # claude/agents/skill-example/references/protocol.md). They are loaded on
    # demand just like skill references, so enforce the reference budget on all
    # nested agent markdown resources without relaxing the entrypoint cap.
    agents = ROOT / "claude" / "agents"
    for path in sorted(agents.glob("**/*.md")):
        if path.parent == agents:
            continue
        words = word_count(path)
        if words > REFERENCE_LIMIT:
            errors.append(
                f"{rel(path)} has {words} words; reference limit is {REFERENCE_LIMIT}"
                " — split it by topic"
            )


def skill_root_of(path: Path) -> Path | None:
    """Return the claude/skills/<name> directory containing path, if any."""
    skills = ROOT / "claude" / "skills"
    try:
        parts = path.relative_to(skills).parts
    except ValueError:
        return None
    return skills / parts[0] if parts else None


def agent_root_of(path: Path) -> Path | None:
    """Return the runner resource directory containing path, if any.

    Canonical agent entrypoints remain flat so the Codex generator can discover
    them. A runner's private resources instead live at
    ``claude/agents/<runner>/references/``; relative citations from those files
    should resolve from that runner directory before falling back to a shared
    agents path.
    """
    agents = ROOT / "claude" / "agents"
    try:
        parts = path.relative_to(agents).parts
    except ValueError:
        return None
    if len(parts) < 2 or parts[0] == "references":
        return None
    return agents / parts[0]


def resolve_link(citing: Path, raw: str) -> Path | None:
    """Map a cited markdown path to the repo file it should point at."""
    for prefix, target_dir in (
        ("~/.claude/skills/", ROOT / "claude" / "skills"),
        ("~/.agents/skills/", ROOT / "claude" / "skills"),
        ("~/.claude/agents/", ROOT / "claude" / "agents"),
        ("~/.claude/rules/", ROOT / "claude" / "rules"),
        ("~/.agents/rules/", ROOT / "claude" / "rules"),
    ):
        if raw.startswith(prefix):
            return target_dir / raw[len(prefix) :]
    if raw.startswith("~"):
        return None  # some other home path; not ours to validate

    # Relative citation: try the citing file's directory, then its runner or
    # skill root, followed by shared cross-agent/cross-skill locations.
    candidates = [citing.parent / raw]
    agent_root = agent_root_of(citing)
    if agent_root is not None:
        candidates.append(agent_root / raw)
    root = skill_root_of(citing)
    if root is not None:
        candidates.append(root / raw)
    candidates.append(ROOT / "claude" / "agents" / raw)
    candidates.append(ROOT / "claude" / "skills" / raw)
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    return candidates[-1]


def check_links(errors: list[str]) -> None:
    """Every concrete markdown path cited by a skill or agent must resolve."""
    files = sorted((ROOT / "claude" / "skills").glob("**/*.md"))
    files += sorted((ROOT / "claude" / "agents").glob("**/*.md"))

    for path in sorted(files):
        for raw in LINK_PATTERN.findall(path.read_text(errors="replace")):
            # Bare filenames (`gotchas.md`) are usually prose, not citations.
            if "/" not in raw or LINK_PLACEHOLDER.search(raw):
                continue
            target = resolve_link(path, raw)
            if target is not None and not target.is_file():
                errors.append(f"{rel(path)} cites missing file: {raw}")


def check_home_links(errors: list[str], skip_home: bool) -> None:
    if skip_home:
        return

    expected = {
        HOME / ".codex" / "agents": ROOT / "codex" / "agents",
        HOME / ".agents" / "rules": ROOT / "agents" / "rules",
        HOME / ".claude" / "agents": ROOT / "claude" / "agents",
        HOME / ".claude" / "rules": ROOT / "claude" / "rules",
    }
    for path, target in expected.items():
        if not path.exists():
            errors.append(f"missing home link: {path}")
            continue
        try:
            resolved = path.resolve()
        except OSError as exc:
            errors.append(f"could not resolve {path}: {exc}")
            continue
        if resolved != target.resolve():
            errors.append(f"{path} resolves to {resolved}, expected {target.resolve()}")

    if (HOME / ".AGENTS.md").exists() or (HOME / ".AGENTS.md").is_symlink():
        errors.append("~/.AGENTS.md should not exist; AGENTS.md is repo-local only")

    # Removing a repo file leaves its $HOME symlink dangling; rcup cannot clean
    # these up, and a dangling reference file is visible to the agent as a
    # readable path that then fails.
    for root in (
        HOME / ".claude" / "agents",
        HOME / ".claude" / "skills",
        HOME / ".claude" / "hooks",
    ):
        if not root.is_dir():
            continue
        for path in sorted(root.rglob("*")):
            if path.is_symlink() and not path.exists():
                errors.append(f"dangling home symlink: {path}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Check local Claude/Codex instruction drift.")
    parser.add_argument("--skip-home", action="store_true", help="skip $HOME symlink checks")
    parser.add_argument(
        "--runner-pairs-root",
        type=Path,
        metavar="DIR",
        help=(
            "validate only skill/runner metadata in a fixture containing "
            "skills/ and agents/ directories"
        ),
    )
    args = parser.parse_args()

    errors: list[str] = []
    if args.runner_pairs_root:
        fixture_root = args.runner_pairs_root.resolve()
        check_runner_pairs(errors, fixture_root / "skills", fixture_root / "agents")
    else:
        check_repo_links(errors)
        check_codex_agents(errors)
        check_runner_pairs(errors)
        check_budget(errors)
        check_links(errors)
        check_home_links(errors, args.skip_home)

    if errors:
        print("agent drift detected:")
        for error in errors:
            print(f"- {error}")
        return 1

    print("agent drift check passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
