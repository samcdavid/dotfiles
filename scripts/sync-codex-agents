#!/usr/bin/env python3
"""Generate Codex custom-agent TOML files from Claude agent markdown files."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import sys


ROOT = Path(__file__).resolve().parents[1]
CLAUDE_AGENTS = ROOT / "claude" / "agents"
CODEX_AGENTS = ROOT / "codex" / "agents"
CRITICAL_AGENT_NAMES = {
    "adversarial-debate",
    "arch-reviewer",
    "perf-reviewer",
    "security-reviewer",
}


def parse_agent(path: Path) -> tuple[dict[str, str], str]:
    text = path.read_text()
    if not text.startswith("---"):
        raise ValueError(f"{path} does not start with frontmatter")

    match = re.match(r"\A---\s*\n(.*?)\n---\s*\n?(.*)\Z", text, re.DOTALL)
    if not match:
        raise ValueError(f"{path} has malformed frontmatter")

    raw_frontmatter, body = match.groups()
    frontmatter: dict[str, str] = {}
    for line in raw_frontmatter.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if ":" not in line:
            raise ValueError(f"{path} frontmatter line is not key/value: {line!r}")
        key, value = line.split(":", 1)
        frontmatter[key.strip()] = value.strip().strip("\"'")

    for required in ("name", "description"):
        if not frontmatter.get(required):
            raise ValueError(f"{path} is missing required frontmatter key: {required}")

    return frontmatter, body.strip() + "\n"


def toml_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def codex_model_fields(agent_name: str, claude_model: str | None) -> list[str]:
    """Map Claude model intent to optional Codex agent config.

    Claude's `opus` means "use the expensive/high-judgment model." Codex cannot
    run Claude models, so we preserve that intent by increasing reasoning effort
    for generated Codex agents. Set CODEX_CRITICAL_MODEL to pin a Codex model too.
    """

    if claude_model != "opus" and agent_name not in CRITICAL_AGENT_NAMES:
        return []

    critical_model = os.environ.get("CODEX_CRITICAL_MODEL", "").strip()
    reasoning_effort = os.environ.get("CODEX_CRITICAL_REASONING_EFFORT", "xhigh").strip()

    fields = [
        "# Critical/high-judgment agent.",
        "# Generated with elevated Codex reasoning effort for critical/high-judgment work.",
    ]
    if critical_model:
        fields.append(f"model = {toml_string(critical_model)}")
    if reasoning_effort:
        fields.append(f"model_reasoning_effort = {toml_string(reasoning_effort)}")
    return fields


def render_agent(source_path: Path, frontmatter: dict[str, str], body: str) -> str:
    lines = [
        "# Generated by scripts/sync-codex-agents. Do not edit by hand.",
        f"# Source: {source_path.relative_to(ROOT)}",
        f"name = {toml_string(frontmatter['name'])}",
        f"description = {toml_string(frontmatter['description'])}",
    ]
    lines.extend(codex_model_fields(frontmatter["name"], frontmatter.get("model")))
    lines.append(f"developer_instructions = {toml_string(body)}")
    return "\n".join(lines) + "\n"


def sync(check: bool) -> int:
    if not CLAUDE_AGENTS.is_dir():
        print(f"missing source directory: {CLAUDE_AGENTS}", file=sys.stderr)
        return 1

    generated: dict[Path, str] = {}
    for source_path in sorted(CLAUDE_AGENTS.glob("*.md")):
        frontmatter, body = parse_agent(source_path)
        target_path = CODEX_AGENTS / f"{frontmatter['name']}.toml"
        generated[target_path] = render_agent(source_path, frontmatter, body)

    existing = set(CODEX_AGENTS.glob("*.toml")) if CODEX_AGENTS.exists() else set()
    stale = existing - set(generated)

    changes: list[str] = []
    for target_path, content in generated.items():
        old = target_path.read_text() if target_path.exists() else None
        if old != content:
            changes.append(str(target_path.relative_to(ROOT)))
            if not check:
                target_path.parent.mkdir(parents=True, exist_ok=True)
                target_path.write_text(content)

    for target_path in sorted(stale):
        changes.append(str(target_path.relative_to(ROOT)))
        if not check:
            target_path.unlink()

    if changes:
        action = "would update" if check else "updated"
        for path in changes:
            print(f"{action}: {path}")
        return 1 if check else 0

    print("codex agents are in sync")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Generate codex/agents/*.toml from claude/agents/*.md."
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="report drift without writing files",
    )
    args = parser.parse_args()
    return sync(args.check)


if __name__ == "__main__":
    raise SystemExit(main())
