#!/usr/bin/env python3
"""Generate OpenCode subagent markdown files from claude/agents/*.md.

claude/agents/*.md is the single source of truth for every agent's identity,
prompt, and tool intent; scripts/sync-codex-agents renders the same source
for Codex. This script renders it for OpenCode's markdown agent format
(https://opencode.ai/docs/agents/). Adding another target (e.g. a future
"pi" tool) means writing one more render_* script against
scripts/lib/agent_frontmatter.parse_agent — never a second source of truth.
"""

from __future__ import annotations

import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.agent_frontmatter import parse_agent  # noqa: E402


ROOT = Path(__file__).resolve().parents[1]
CLAUDE_AGENTS = ROOT / "claude" / "agents"
OPENCODE_AGENTS = ROOT / "config" / "opencode" / "agents"

# Claude Code tool names (PascalCase) -> OpenCode permission keys (lowercase).
# OpenCode has no NotebookEdit equivalent, so it is dropped rather than guessed.
TOOL_NAME_MAP = {
    "Edit": "edit",
    "Write": "edit",
    "Bash": "bash",
    "Read": "read",
    "Glob": "glob",
    "Grep": "grep",
    "WebFetch": "webfetch",
    "WebSearch": "websearch",
    "Agent": "task",
}


def yaml_string(value: str) -> str:
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def permission_block(disallowed: str | None) -> list[str]:
    if not disallowed:
        return []
    names = [n.strip() for n in disallowed.split(",") if n.strip()]
    keys = sorted({TOOL_NAME_MAP[n] for n in names if n in TOOL_NAME_MAP})
    if not keys:
        return []
    lines = ["permission:"]
    for key in keys:
        lines.append(f"  {key}: deny")
    return lines


def render_agent(source_path: Path, frontmatter: dict[str, str], body: str) -> str:
    lines = [
        "---",
        "# Generated by scripts/sync-opencode-agents. Do not edit by hand.",
        f"# Source: {source_path.relative_to(ROOT)}",
        f"description: {yaml_string(frontmatter['description'])}",
        "mode: subagent",
    ]
    opencode_model = frontmatter.get("opencode-model")
    if opencode_model:
        lines.append(f"model: {yaml_string(opencode_model)}")
    lines.extend(permission_block(frontmatter.get("disallowedTools")))
    lines.append("---")
    lines.append("")
    lines.append(body.rstrip() + "\n")
    return "\n".join(lines)


def sync(check: bool) -> int:
    if not CLAUDE_AGENTS.is_dir():
        print(f"missing source directory: {CLAUDE_AGENTS}", file=sys.stderr)
        return 1

    generated: dict[Path, str] = {}
    for source_path in sorted(CLAUDE_AGENTS.glob("*.md")):
        frontmatter, body = parse_agent(source_path)
        target_path = OPENCODE_AGENTS / f"{frontmatter['name']}.md"
        generated[target_path] = render_agent(source_path, frontmatter, body)

    existing = set(OPENCODE_AGENTS.glob("*.md")) if OPENCODE_AGENTS.exists() else set()
    stale = existing - set(generated)

    changes: list[str] = []
    for target_path, content in generated.items():
        old = target_path.read_text() if target_path.exists() else None
        if old != content:
            changes.append(str(target_path.relative_to(ROOT)))
            if not check:
                target_path.parent.mkdir(parents=True, exist_ok=True)
                target_path.write_text(content)

    for target_path in sorted(stale):
        changes.append(str(target_path.relative_to(ROOT)))
        if not check:
            target_path.unlink()

    if changes:
        action = "would update" if check else "updated"
        for path in changes:
            print(f"{action}: {path}")
        return 1 if check else 0

    print("opencode agents are in sync")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Generate config/opencode/agents/*.md from claude/agents/*.md."
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="report drift without writing files",
    )
    args = parser.parse_args()
    return sync(args.check)


if __name__ == "__main__":
    raise SystemExit(main())
