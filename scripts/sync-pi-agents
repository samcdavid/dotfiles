#!/usr/bin/env python3
"""Generate pi subagent markdown files from claude/agents/*.md.

claude/agents/*.md is the single source of truth; scripts/sync-codex-agents
and scripts/sync-opencode-agents render the same source for their targets.
This renders it for the agent format read by pi's bundled subagent extension
(examples/extensions/subagent in @earendil-works/pi-coding-agent), which
discovers ~/.pi/agent/agents/*.md.
"""

from __future__ import annotations

import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.agent_frontmatter import parse_agent  # noqa: E402


ROOT = Path(__file__).resolve().parents[1]
CLAUDE_AGENTS = ROOT / "claude" / "agents"
PI_AGENTS = ROOT / "pi" / "agent" / "agents"

# pi's `tools:` is an allowlist passed straight to `pi --tools`, while Claude
# agents express intent as a denylist, so the denylist is subtracted from
# every built-in pi tool. Agent/NotebookEdit have no pi built-in to remove.
PI_TOOLS = ["read", "bash", "edit", "write", "grep", "find", "ls"]
TOOL_NAME_MAP = {
    "Edit": "edit",
    "Write": "write",
    "Bash": "bash",
    "Read": "read",
    "Grep": "grep",
    "Glob": "find",
}


def yaml_string(value: str) -> str:
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def allowed_tools(disallowed: str | None) -> list[str] | None:
    if not disallowed:
        return None
    names = [n.strip() for n in disallowed.split(",") if n.strip()]
    denied = {TOOL_NAME_MAP[n] for n in names if n in TOOL_NAME_MAP}
    if not denied:
        return None
    return [tool for tool in PI_TOOLS if tool not in denied]


def render_agent(source_path: Path, frontmatter: dict[str, str], body: str) -> str:
    lines = [
        "---",
        "# Generated by scripts/sync-pi-agents. Do not edit by hand.",
        f"# Source: {source_path.relative_to(ROOT)}",
        f"name: {frontmatter['name']}",
        f"description: {yaml_string(frontmatter['description'])}",
    ]
    tools = allowed_tools(frontmatter.get("disallowedTools"))
    if tools:
        lines.append(f"tools: {', '.join(tools)}")
    # Claude model names don't exist on pi's providers, so only an explicit
    # pi-model pin is rendered; otherwise the subagent inherits the session.
    pi_model = frontmatter.get("pi-model")
    if pi_model:
        lines.append(f"model: {yaml_string(pi_model)}")
    lines.append("---")
    lines.append("")
    lines.append(body.rstrip() + "\n")
    return "\n".join(lines)


def sync(check: bool) -> int:
    if not CLAUDE_AGENTS.is_dir():
        print(f"missing source directory: {CLAUDE_AGENTS}", file=sys.stderr)
        return 1

    generated: dict[Path, str] = {}
    for source_path in sorted(CLAUDE_AGENTS.glob("*.md")):
        frontmatter, body = parse_agent(source_path)
        target_path = PI_AGENTS / f"{frontmatter['name']}.md"
        generated[target_path] = render_agent(source_path, frontmatter, body)

    existing = set(PI_AGENTS.glob("*.md")) if PI_AGENTS.exists() else set()
    stale = existing - set(generated)

    changes: list[str] = []
    for target_path, content in generated.items():
        old = target_path.read_text() if target_path.exists() else None
        if old != content:
            changes.append(str(target_path.relative_to(ROOT)))
            if not check:
                target_path.parent.mkdir(parents=True, exist_ok=True)
                target_path.write_text(content)

    for target_path in sorted(stale):
        changes.append(str(target_path.relative_to(ROOT)))
        if not check:
            target_path.unlink()

    if changes:
        action = "would update" if check else "updated"
        for path in changes:
            print(f"{action}: {path}")
        return 1 if check else 0

    print("pi agents are in sync")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Generate pi/agent/agents/*.md from claude/agents/*.md."
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="report drift without writing files",
    )
    args = parser.parse_args()
    return sync(args.check)


if __name__ == "__main__":
    raise SystemExit(main())
